{
  "name": "functions",
  "scripts": {
    "lint": "node -e \"console.log('[lint] skipped — use tsc build as gate');\"",
    "build": "node node_modules/typescript/bin/tsc && node scripts/copy-assets.js",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "20"
  },
  "type": "module",
  "main": "lib/index.js",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "node-cache": "^5.1.2",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^6.3.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "typescript": "^5.6.0"
  },
  "private": true
}