# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
dist-ssr/
*.local

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment variables
.env
.env.local
.env.*.local

# Firebase / GCP service-account private keys (never commit)
*-firebase-adminsdk-*.json
*firebase-adminsdk*.json
service-account*.json
firebase-service-account.json
secrets/
*.pem

# Local stock data cache (downloaded by scripts/fetch-universe.js, ~52MB)
data/stocks/
data/manifest.json
# Firebase RTDB dumps (large; never commit — wipe/re-export locally if needed)
data/*rtdb*
data/*-rtdb-export.json
data/kfinance032926-default-rtdb-export.json

# Historical price data from worlddatamap (~220MB, 4047 tickers)
prices/

# Testing
coverage/
test-output*.txt

# Cache
.cache/
.temp/
*.tgz

# Dynamic server port (auto-generated)
.server-port

# Daily API response cache (auto-generated, 1 file per market per day)
server/datacache/

# Optional eslint cache
.eslintcache

# Misc
*.tsbuildinfo
.worktrees/

# Claude Code internal state (per-session locks etc.)
.claude/

# Validation artifacts — regenerated by `npm run test:validate` / `test:audit`
test-results/

# Backup files from iterative script edits
scripts/*.backup

# User screenshots
/screenshots/discardable/

