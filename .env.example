# Global Market Hub — environment template
#
# Copy this file to `.env` and fill in your keys, OR run `node scripts/setup-env.js`
# to be walked through it interactively. None of these are committed (`.env` is
# in .gitignore). Routes that depend on a missing key fall through to a
# "Data source temporarily unavailable" placeholder; the rest of the app
# still runs.

# ───────────────────────────────────────────────────────────────────────
# FRED — St. Louis Fed Federal Reserve Economic Data
# Used by: bonds, commodities, credit, derivatives, equityDeepDive, fx,
#          globalMacro, insurance, macro, realEstate, sentiment, calendar,
#          and as a BLS fallback for the BLS tab.
# Get a free key (instant, no review): https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# ───────────────────────────────────────────────────────────────────────
# EIA — US Energy Information Administration
# Used by: commodities (petroleum / natgas series), eia tab
# Get a free key (instant): https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# ───────────────────────────────────────────────────────────────────────
# BLS — Bureau of Labor Statistics
# Used by: bls tab, globalMacro (employment series).
# Without it the bls route falls back to FRED mirrors automatically (FRED
# carries every series we use), so this is optional if FRED_API_KEY is set.
# Get a free key (instant): https://data.bls.gov/registrationEngine/
BLS_API_KEY=

# ───────────────────────────────────────────────────────────────────────
# BEA — US Bureau of Economic Analysis (NIPA detail)
# Used by: /api/bea (GDP components, personal income, savings rate)
# Get a free key (instant): https://apps.bea.gov/API/signup/
BEA_API_KEY=

# ───────────────────────────────────────────────────────────────────────
# SEC EDGAR — XBRL company financial data
# Used by: /api/edgar
# SEC mandates a User-Agent identifying the requester. Format:
#   "Your Name your@email.com" — not a key, just contact info.
# Without this they'll throttle the generic UA aggressively.
# https://www.sec.gov/os/accessing-edgar-data
EDGAR_USER_AGENT=

# ───────────────────────────────────────────────────────────────────────
# Yahoo Finance OAuth — only required if you switch the Yahoo client
# from the public scrape path to authenticated calls (currently unused
# by the default code path; safe to leave blank).
YAHOO_APP_ID=
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
YAHOO_APP_NAME=
YAHOO_REDIRECT_URI=https://localhost:3001/auth/callback
YAHOO_HOMEPAGE_URL=https://localhost:5173

# ───────────────────────────────────────────────────────────────────────
# Client-side keys (VITE_ prefix → bundled into the browser at build time;
# only put values here that are SAFE to expose publicly).

# When the frontend is deployed to static hosting (GitHub Pages, etc.) it cannot
# use the local dev proxy. Set this to the *root* of your deployed Firebase
# Functions (or Cloud Run) service so that all /api/* calls go to the real backend.
#
# After you run `firebase deploy --only functions`, the output will show the
# correct URL for the `api` function. Example:
#   https://us-central1-kfinance032926.cloudfunctions.net/api
#
# You can also set this as a GitHub Repository Variable (recommended for CI):
#   Settings → Secrets and variables → Actions → Variables → New variable
#   Name: VITE_API_BASE_URL
#   Value: https://us-central1-kfinance032926.cloudfunctions.net/api
VITE_API_BASE_URL=
